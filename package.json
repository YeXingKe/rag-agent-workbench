{
  "name": "rag-agent-workbench",
  "version": "0.1.0",
  "description": "RAG Agent Workbench - Python Flask Backend + React Frontend",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && python main.py",
    "dev:web": "cd web && npm run dev",
    "install:all": "npm run install:server && npm run install:web",
    "install:server": "cd server && pip install -r requirements.txt",
    "install:web": "cd web && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "flask",
    "react",
    "antd",
    "python",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
