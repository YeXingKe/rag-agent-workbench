# ===== 应用配置 =====
APP_NAME=RAG Agent Workbench
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# 对齐参考 Python：api_v1_prefix
API_V1_PREFIX=/api/v1
ALLOW_ORIGINS=http://localhost:5173

# ===== 数据库配置 =====
POSTGRES_DSN=postgresql://postgres:your_password@localhost:5432/rag_db

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus 配置 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_base
MILVUS_DIMENSION=1536

# ===== AI 模型配置 =====
DASHSCOPE_API_KEY=sk-your-api-key-here
MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v1

# ===== 文件存储 =====
STORAGE_ROOT=storage
UPLOAD_DIR_NAME=uploads
MAX_UPLOAD_SIZE_MB=20

# ===== OCR（可选）=====
OCR_ENABLED=false
OCR_TASK_URL=
OCR_QUERY_URL=
OCR_TOKEN_URL=
OCR_ACCESS_TOKEN=
OCR_CLIENT_ID=
OCR_CLIENT_SECRET=
OCR_PDF_MIN_PAGE_CHARS=80
OCR_PDF_EMPTY_PAGE_RATIO=0.35
OCR_PDF_LOW_TEXT_AVG_CHARS=120
OCR_TABLE_LIKE_LINE_THRESHOLD=3
OCR_DOCX_MIN_CHARS=200
OCR_POLL_MAX_ATTEMPTS=30
OCR_POLL_INTERVAL_SEC=2
